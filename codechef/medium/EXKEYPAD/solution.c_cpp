#include <bits/stdc++.h>
using namespace std;

void solve() {
    string S;
    int D;
    
    cin>>S>>D;
    
    int first_D = -1;
    for (int i=0; i<S.length(); i++) {
        if (S[i] - '0' == D) {
            first_D = i;
            break;
        }
    }
    
    if (first_D == -1) {
        cout<<S<<"\n";
        return;
    }
    
    int carry = 1;
    int last_increased_idx = first_D;
    
    for (int i = first_D; i>=0; i--) {
        int val = (S[i] - '0') + carry;
        carry = 0;
        
        if (val == D) {
            val++;
        }
        
        if (val > 9) {
            val = (D == 0) ? 1 : 0;
            carry = 1;
        }
        
        S[i] == val + '0';
        if (carry == 0) {
            last_increased_idx = i;
            break;
        }
    }
    
    char min_digit = (D == 0) ? '1' : '0';
    
    if (carry > 0) {
        int val = 1;
        if (val == D) val++;
        S = to_string(val) + S;
        last_increased_idx = 0;
    }
    
    for (int i = last_increased_idx + 1; i<S.length(); i++) {
        S[i] = min_digit;
    }
    
    cout<<S<<"\n";
}

int main() {
	// your code goes here
	
	int T;
	cin>>T;
	while (T--) {
	    solve();
	}
	
	return 0;

}
