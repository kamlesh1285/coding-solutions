#include <bits/stdc++.h>
using namespace std;

void solve() {
    string S;
    int D;
    
    cin>>S>>D;
    
    int first_conflict = -1;
    for (int i=0; i<S.length(); i++) {
        if (S[i] - '0' == D) {
            first_conflict = i;
            break;
        }
    }
    
    if (first_conflict == -1) {
        cout<<S<<"\n";
        return;
    }
    
    bool incremented = false;
    for (int i = first_conflict; i>=0; i--) {
        int cur_digit = S[i] - '0';
        int next_digit = cur_digit + 1;
        
        if (next_digit == D) {
            next_digit++;
        }
        
        if (next_digit <= 9) {
            S[i] = next_digit + '0';
            
            char fill_digit = (D == 0) ? '1' : '0';
            for (int j=i+1; j<S.length(); j++) {
                S[j] = fill_digit;
            }
            incremented = true;
            break;
        }
    }
    
    if (!incremented) {
        int lead = (D==1) ? 2 : 1;
        string fill_str(S.length(), (D == 0) ? '1' : '0');
        S = to_string(lead) + fill_str;
    }
    
    cout<< S << "\n";
}

int main() {
	// your code goes here
	
	int T;
	cin>>T;
	while (T--) {
	    solve();
	}
	
	return 0;

}
