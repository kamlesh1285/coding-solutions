#include <bits/stdc++.h>
using namespace std;

void solve() {
    int N;
    cin>>N;
    
    vector<int> A(N);
    set<int> present_elements;
    
    for (int i=0; i<N; i++) {
        cin>>A[i];
        present_elements.insert(A[i]);
        
    }
    
    int mex = 0;
    while (present_elements.count(mex)) {
        mex++;
    }
    
    long long total_moves = 0;
    for (int i = 0; i < N; i++) {
        if (A[i] > mex) {
            total_moves += (A[i] - mex);
        }
    }
    
    if (total_moves % 2 != 0) {
        cout<<"Alice"<<"\n";
    } 
    else {
        cout<<"Bob"<<"\n";
    }
}

int main() {
	// your code goes here
	int T;
	cin>>T;
	while (T--) {
	    solve();
	}

}
