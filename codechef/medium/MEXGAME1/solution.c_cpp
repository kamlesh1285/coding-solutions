#include <bits/stdc++.h>
#include <map>
using namespace std;

void solve() {
    int N;
    cin>>N;
    
    vector<int> A(N);
    map<int> freq;
    set<int> present;
    
    for (int i=0; i<N; i++) {
        cin>>A[i];
        present.insert(A[i]);
        
    }
    
    int mex = 0;
    while (present.count(mex)) {
        mex++;
    }
    
    long long total_moves = 0;
    
    for (auto const& [val, count] : freq) {
        if (val > mex) {
            total_moves += (long long)(val - mex - 1) * count;
        } else if (val < mex && val > 0) {
            total_moves += (long long)val * (count - 1);
        }
    }
    
    if (total_moves % 2 != 0) {
        cout<<"Alice"<<"\n";
    } 
    else {
        cout<<"Bob"<<"\n";
    }
}

int main() {
	// your code goes here
	int T;
	cin>>T;
	while (T--) {
	    solve();
	}

}
