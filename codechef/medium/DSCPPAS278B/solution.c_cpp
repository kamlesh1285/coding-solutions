#include <bits/stdc++.h>

using namespace std;

int maxSumKElements(const vector<int>& arr, int k) {
    // Write your code here
    int n = arr.size();
    long long current_sum = 0;
    
    for (int i = 0; i < k; ++i) {
        current_sum += arr[i];
    }
    
    long long max_sum = current_sum;
    
    for (int i = 0; i < k; ++i) {
        current_sum -= arr[k - 1 - i];
        current_sum += arr[n - 1 - i];
        if (current_sum > max_sum) {
            max_sum = current_sum;
        }
    }
    
    return max_sum;
}

int main() {
    int n, k;
    
    cin >> n;
    cin >> k;
    
    vector<int> arr(n);
    
    for (int i = 0; i < n; ++i) {
        cin >> arr[i];
    }
    
    cout << maxSumKElements(arr, k) << endl;
    
    return 0;
}
