#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        int degree = 0;
        for (int i = 0; i < N; i++) {
            int coefficient;
            cin >> coefficient;

            if (coefficient != 0) {
                degree = i; // coefficient of x^i
            }
        }

        cout << degree << '\n';
    }

    return 0;
}