#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;
    while (T--) {
        int X, Y, R;
        cin >> X >> Y >> R;

        // Each extra stick beyond X gives 30 rupees
        int extraSticks = R / 30;

        // Total sticks Chef must have eaten
        int totalSticks = X + extraSticks;

        // Maximum plates: ceil(totalSticks / Y)
        // ceil(a/b) = (a + b - 1) / b using integer arithmetic
        int plates = (totalSticks + Y - 1) / Y;

        cout << plates << "\n";
    }

    return 0;
}