#include <bits/stdc++.h>
using namespace std;


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int a[3], b[3];
        for (int i = 0; i < 3; i++) cin >> a[i];
        for (int i = 0; i < 3; i++) cin >> b[i];

        sort(a, a + 3);
        sort(b, b + 3);

        int aliceScore = a[1] + a[2]; // two highest rolls
        int bobScore = b[1] + b[2];

        if (aliceScore > bobScore) {
            cout << "Alice\n";
        } else if (bobScore > aliceScore) {
            cout << "Bob\n";
        } else {
            cout << "Tie\n";
        }
    }

    return 0;
}
