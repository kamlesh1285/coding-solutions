#include <bits/stdc++.h>
using namespace std;


#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        long long N, A, B;
        cin >> N >> A >> B;

        long long rounds = log2(N);
        long long totalTime = rounds * A + (rounds - 1) * B;

        cout << totalTime << '\n';
    }

    return 0;
}
