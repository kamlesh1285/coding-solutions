#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;
    while (T--) {
        long long A, B, K;
        cin >> A >> B >> K;

        // Distance Chef needs to cover
        long long distance = abs(A - B);

        // Minimum steps = ceil(distance / K)
        long long steps = (distance + K - 1) / K;

        cout << steps << "\n";
    }

    return 0;
}