#include <bits/stdc++.h>
using namespace std;

int main() {
    int R, O, C;
    cin >> R >> O >> C;

    
    int remainingOvers = 20 - O;

    
    int maxAdditionalRuns = remainingOvers * 6 * 6;

    int maxPossibleScore = C + maxAdditionalRuns;

    if (maxPossibleScore > R) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }

    return 0;
}
