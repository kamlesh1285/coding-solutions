#include <bits/stdc++.h>
using namespace std;

void solve() {
    long long N;
    cin >> N;
    long long res = 1;
    
    for (int i = 1; i <= N; i++) {
        res *= i;
    }
    
    cout << res << "\n";
}

int main() {
    
    int T;
    cin >> T;
    while (T--) {
        solve();
    }
    return 0;
}